# AI Student Feedback Analyzer - Environment Configuration
# Copy this file to .env and adjust credentials if needed

# Database Settings (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ai_student_feedback

# Optional: set to True if MySQL server is unavailable on evaluation laptop
USE_SQLITE=False

# Flask Secret Key for sessions
SECRET_KEY=change_this_to_a_random_secret_key_in_production

# Optional Gemini API key (Application runs 100% offline using Python NLP if not set)
GEMINI_API_KEY=
